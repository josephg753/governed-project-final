{
  "policy_name": "Lakeshore Consortium Analytics Agent Policy",
  "policy_version": "1.1",
  "change_log": [
    "1.0 template defaults",
    "1.1 team tools added to the allow list (13 analytics tools); triage_queue, what_if and read_discharge_note made record-level; model floor raised from 0.66 to 0.68 to match the charter's global floor (pre-check now refuses a lower one)"
  ],
  "system": "Lakeshore consortium analytics agent team",
  "owner": "BANA 690A final project team, Lakeshore General Health IT role (governance and CI owner)",
  "approved_by": "Consortium Steering Committee (team governance owner signs for the course)",
  "purpose": "Answer descriptive, diagnostic, predictive and prescriptive questions about 30-day readmission across the consortium, and arrange follow-up resources for high-risk discharges at the home member. Decision support only: a clinician approves every action that reaches a patient.",

  "allowed_tools": ["summarize_member", "segment_breakdown", "trend_by_month", "segment_table_across_members", "month_over_month",
                    "compare_members", "rank_drivers", "stratified_comparison", "feature_effect_by_member", "explain_change",
                    "model_card_facts", "predict_record", "rank_records_by_risk", "member_model_comparison", "high_risk_count", "calibration_check", "what_if",
                    "recommend_action", "triage_queue", "read_discharge_note",
                    "flag_chart_for_pharmacist", "schedule_followup_call", "request_home_visit"],
  "approval_required": ["schedule_followup_call", "request_home_visit"],
  "forbidden_for_any_agent": ["change_discharge_decision", "export_records"],

  "record_level_tools": ["predict_record", "rank_records_by_risk", "what_if", "recommend_action", "triage_queue", "read_discharge_note",
                         "flag_chart_for_pharmacist", "schedule_followup_call", "request_home_visit"],
  "max_tool_calls_per_task": 12,
  "max_records_per_task": 3,
  "data_scope": {
    "aggregate_members": ["Lakeshore General", "St. Brigid", "Riverbend", "Pinecrest Rural", "Harbor Children's and Adults"],
    "record_level_members": ["Lakeshore General"]
  },

  "model": {
    "path": "models/federated_model.json",
    "charter_path": "governance/federation_policy.json",
    "min_neutral_test_accuracy": 0.68,
    "high_risk_threshold": 0.5,
    "allowed_uses": ["follow-up prioritization", "discharge planning resources"],
    "prohibited_uses": ["coverage decisions", "pricing", "denying or delaying a discharge", "any use by a payer"]
  },

  "logging": { "audit_log": "artifacts/agent_audit_log.jsonl", "log_arguments": true },
  "stop_on_violation": true,
  "expose_tools_to_planner": "all"
}
